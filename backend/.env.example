# Server Configuration
PORT=3000
NODE_ENV=development

# ==============================================================================
# FIREBASE CONFIGURATION
# You can use EITHER Option 1 (individual keys) OR Option 2 (full JSON string).
# ==============================================================================

# Option 1: Individual Firebase Admin Credentials
FIREBASE_PROJECT_ID=donateblood-bd
FIREBASE_CLIENT_EMAIL=your-firebase-adminsdk@donateblood-bd.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Option 2: Full Firebase Service Account JSON (Alternative to Option 1)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"donateblood-bd","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

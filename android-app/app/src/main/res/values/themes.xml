<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.DonateBlood" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your theme here -->
        <item name="colorPrimary">@color/primary_red</item>
        <item name="colorPrimaryVariant">@color/primary_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_red</item>
        <item name="colorSecondaryVariant">@color/primary_red_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/primary_red</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary_red_dark</item>

        <!-- Navigation bar (Edge-to-edge LinkedIn bottom) -->
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background_light</item>

        <!-- Material Pickers default themes -->
        <item name="materialCalendarTheme">@style/ThemeOverlay.BloodLink.MaterialCalendar</item>
        <item name="materialTimePickerTheme">@style/ThemeOverlay.BloodLink.MaterialTimePicker</item>

        <!-- Toolbar/ActionBar theme -->
        <item name="toolbarStyle">@style/Widget.DonateBlood.Toolbar</item>

        <!-- ADD THESE 3 LINES FOR TEXT VISIBILITY -->
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <!-- Toolbar style -->
    <style name="Widget.DonateBlood.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/primary_red</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
    </style>

    <!-- Toolbar Title & Subtitle TextAppearances matching Chat & Message styling -->
    <style name="TextAppearance.BloodLink.Toolbar.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.BloodLink.Toolbar.Subtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#E0E0E0</item>
    </style>

    <!-- Material Date Picker & Time Picker Theme Overlays in BloodLink Theme -->
    <style name="ThemeOverlay.BloodLink.MaterialCalendar" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/primary_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_red</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.BloodLink.MaterialTimePicker" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">@color/primary_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_red</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <!-- Custom Bottom Sheet Dialog Theme with transparent background so rounded card shows -->
    <style name="Theme.BloodLink.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.BloodLink.BottomSheet</item>
    </style>

    <style name="Widget.BloodLink.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Directory TabLayout Text Appearance -->
    <style name="TextAppearance.BloodLink.Tab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- LinkedIn-Style Bottom Navigation Text Appearances -->
    <style name="TextAppearance.BloodLink.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_red</item>
    </style>

    <style name="TextAppearance.BloodLink.BottomNav.Inactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/gray_600</item>
    </style>

    <!-- LinkedIn-Style Bottom Navigation Active Indicator Style (Transparent & 0dp) -->
    <style name="Widget.BloodLink.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
        <item name="marginHorizontal">0dp</item>
    </style>

    <!-- LinkedIn-Style Production Grade Bottom Navigation -->
    <style name="Widget.BloodLink.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav_linkedin</item>
        <item name="android:minHeight">56dp</item>
        <item name="elevation">0dp</item>
        <item name="itemIconSize">22dp</item>
        <item name="itemIconTint">@drawable/bottom_nav_icon_color_selector</item>
        <item name="itemTextColor">@drawable/bottom_nav_text_color_selector</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.BloodLink.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.BloodLink.BottomNav.Inactive</item>
        <item name="itemRippleColor">@color/bottom_nav_ripple</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.BloodLink.BottomNav.ActiveIndicator</item>
        <item name="itemPaddingTop">11dp</item>
        <item name="itemPaddingBottom">7dp</item>
        <item name="activeIndicatorLabelPadding">0dp</item>
    </style>

    <!-- Drawer Item Pill Shape & Typography -->
    <style name="ShapeAppearance.BloodLink.DrawerItem" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="TextAppearance.BloodLink.DrawerItem" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.BloodLink.DrawerSubheader" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#9CA3AF</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="@color/surface_white"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ================= TOP HEADER: BLOOD BADGE + BADGES + PATIENT ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <!-- Blood Group Badge (2026 Modern Squircle) -->
            <TextView
                android:id="@+id/tvBloodGroupBadge"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_blood_badge_modern"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="O+" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <!-- Badges Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Urgency Tag -->
                    <TextView
                        android:id="@+id/tvUrgencyTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_urgent_2026"
                        android:text="URGENT"
                        android:textColor="@color/primary_red"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_clock"
                        app:drawableTint="@color/primary_red"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        tools:ignore="HardcodedText" />

                    <!-- Units Needed -->
                    <TextView
                        android:id="@+id/tvUnitsBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tag_units_2026"
                        android:textColor="#334155"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        tools:text="2 Units" />
                </LinearLayout>

                <!-- Patient Name -->
                <TextView
                    android:id="@+id/tvPatientName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#0F172A"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Patient: Farhana Akter" />
            </LinearLayout>

        </LinearLayout>

        <!-- ================= METADATA CONTAINER: HOSPITAL + LOCATION + TIME ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_meta_container_2026"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Hospital -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_hospital"
                    app:tint="#64748B"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvHospital"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Dhaka Medical College Hospital" />
            </LinearLayout>

            <!-- Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location_pin"
                    app:tint="#64748B"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:textColor="#64748B"
                    android:textSize="11.5sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Dhaka Sadar, Dhaka" />
            </LinearLayout>

            <!-- DateTime -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="#64748B"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvDateTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:textColor="#64748B"
                    android:textSize="11.5sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Needed: Today, 3:00 PM" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= ACTIONS ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Call Button -->
            <ImageView
                android:id="@+id/btnCall"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_call"
                android:background="@drawable/bg_icon_button_2026"
                android:padding="8dp"
                app:tint="@color/primary_red"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:contentDescription="Call Requester"
                tools:ignore="HardcodedText" />

            <!-- Chat Button -->
            <ImageView
                android:id="@+id/btnChat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_chat"
                android:background="@drawable/bg_icon_button_2026"
                android:padding="8dp"
                app:tint="@color/primary_red"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:contentDescription="Chat with Requester"
                tools:ignore="HardcodedText" />

            <!-- I Can Help Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHelp"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="I Can Help"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="19dp"
                app:backgroundTint="@color/primary_red"
                app:icon="@drawable/ic_blood_drop"
                app:iconSize="14dp"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                android:textAllCaps="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- TOP DRAG HANDLE -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_sheet_drag_handle" />

        <!-- ================= HEADER ROW: BLOOD BADGE + DETAILS + CLOSE ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 50dp SQUIRCLE BLOOD GROUP BADGE -->
            <TextView
                android:id="@+id/tvSheetBloodGroup"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_blood_badge_modern"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="O+" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blood Request Details"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- TAGS ROW: URGENCY + UNITS + STATUS -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvSheetUrgencyTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_urgent_2026"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="URGENT"
                        android:textColor="@color/primary_red"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_clock"
                        app:drawableTint="@color/primary_red"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tvSheetUnitsBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tag_units_2026"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="#334155"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="2 Units Needed" />

                    <TextView
                        android:id="@+id/tvSheetStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tag_needed_2026"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Active" />
                </LinearLayout>
            </LinearLayout>

            <!-- CLOSE BUTTON -->
            <ImageView
                android:id="@+id/ivCloseSheet"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/bg_icon_button_2026"
                android:padding="8.5dp"
                app:tint="#64748B"
                android:contentDescription="Close details sheet"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- ================= COMPATIBILITY BANNER (DYNAMIC) ================= -->
        <LinearLayout
            android:id="@+id/layoutSheetCompatibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tag_compatibility_2026"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_shield_check_small"
                app:tint="#0284C7"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvSheetCompatibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#0284C7"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Your blood group (O+) is compatible with this patient!" />
        </LinearLayout>

        <!-- ================= MEDICAL & PATIENT CONTEXT CONTAINER ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_meta_container_2026"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- PATIENT NAME -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PATIENT NAME"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvSheetPatientName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Farhana Akhter" />
            </LinearLayout>

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#F1F5F9" />

            <!-- HOSPITAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_hospital"
                    app:tint="#64748B"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOSPITAL"
                        android:textColor="#94A3B8"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvSheetHospital"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Dhaka Medical College Hospital" />
                </LinearLayout>
            </LinearLayout>

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#F1F5F9" />

            <!-- LOCATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_location_pin"
                    app:tint="#64748B"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOCATION &amp; DISTRICT"
                        android:textColor="#94A3B8"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvSheetLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#475569"
                        android:textSize="13.5sp"
                        tools:text="Ramna, Dhaka" />
                </LinearLayout>
            </LinearLayout>

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#F1F5F9" />

            <!-- REQUIRED DATE & TIME -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="#64748B"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REQUIRED BY"
                        android:textColor="#94A3B8"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvSheetDateTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#475569"
                        android:textSize="13.5sp"
                        tools:text="15/01/2026 (04:00 PM)" />
                </LinearLayout>
            </LinearLayout>

            <!-- CONTACT PHONE (DYNAMIC) -->
            <LinearLayout
                android:id="@+id/rowSheetPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#F1F5F9" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_call"
                        app:tint="#64748B"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONTACT PHONE"
                            android:textColor="#94A3B8"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/tvSheetPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="01705107279" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- ================= VERIFICATION / SAFETY NOTE ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_meta_container_2026"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_shield_check_small"
                app:tint="#0284C7"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="Verified Emergency: BloodLink safety protocols protect patient and donor privacy. Only respond if you are medically fit to donate."
                android:textColor="#64748B"
                android:textSize="11.5sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- ================= ACTION BUTTONS ROW 1: CALL + CHAT + SHARE ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSheetCall"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Call"
                android:textColor="#1E293B"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:cornerRadius="21dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_call"
                app:iconSize="15dp"
                app:iconTint="@color/primary_red"
                app:iconGravity="textStart"
                android:textAllCaps="false"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSheetChat"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Chat"
                android:textColor="@color/primary_red"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:cornerRadius="21dp"
                app:strokeColor="@color/primary_red"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_chat"
                app:iconSize="15dp"
                app:iconTint="@color/primary_red"
                app:iconGravity="textStart"
                android:textAllCaps="false"
                tools:ignore="HardcodedText" />

            <!-- SHARE BUTTON -->
            <ImageView
                android:id="@+id/btnSheetShare"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_share"
                android:background="@drawable/bg_icon_button_2026"
                android:padding="11dp"
                app:tint="#64748B"
                android:contentDescription="Share request"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- ================= ACTION BUTTONS ROW 2: DIRECTIONS + I CAN HELP ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSheetDirections"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Directions"
                android:textColor="#475569"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_directions"
                app:iconSize="16dp"
                app:iconTint="#475569"
                app:iconGravity="textStart"
                android:textAllCaps="false"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSheetHelp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.3"
                android:layout_marginStart="6dp"
                android:text="I Can Help"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:backgroundTint="@color/crimson_cta_primary"
                android:textAllCaps="false"
                tools:ignore="HardcodedText" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

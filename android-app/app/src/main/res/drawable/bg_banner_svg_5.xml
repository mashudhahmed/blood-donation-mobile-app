<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/apk/res-auto"
    android:width="360dp"
    android:height="140dp"
    android:viewportWidth="360"
    android:viewportHeight="140">

    <!-- Background Card Rectangle with rx=22 -->
    <path
        android:pathData="M 22,0 L 338,0 A 22,22 0 0,1 360,22 L 360,118 A 22,22 0 0,1 338,140 L 22,140 A 22,22 0 0,1 0,118 L 0,22 A 22,22 0 0,1 22,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="360"
                android:endY="140">
                <item android:offset="0.0" android:color="#FFF1F2" />
                <item android:offset="1.0" android:color="#FFE4E6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Floating Soft Circle Top Right r=55 (cx=310, cy=40) opacity 0.15 -->
    <path
        android:fillColor="#26FDA4AF"
        android:pathData="M 310,-15 A 55,55 0 1,0 310,95 A 55,55 0 1,0 310,-15 Z" />

    <!-- Floating Soft Circle Bottom Left r=40 (cx=40, cy=110) opacity 0.1 -->
    <path
        android:fillColor="#1AFB7185"
        android:pathData="M 40,70 A 40,40 0 1,0 40,150 A 40,40 0 1,0 40,70 Z" />

    <!-- Heart Shadow -->
    <path
        android:fillColor="#59FDA4AF"
        android:pathData="M 290,52 C 290,42 304,36 316,46 C 328,36 342,42 342,52 C 342,72 316,90 316,90 C 316,90 290,72 290,52 Z" />

    <!-- Main Heart with Gradient -->
    <path
        android:pathData="M 290,48 C 290,38 304,32 316,42 C 328,32 342,38 342,48 C 342,68 316,86 316,86 C 316,86 290,68 290,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="290"
                android:startY="32"
                android:endX="342"
                android:endY="86">
                <item android:offset="0.0" android:color="#FB7185" />
                <item android:offset="1.0" android:color="#E11D48" />
            </gradient>
        </aapt:attr>
    </path>

</vector>

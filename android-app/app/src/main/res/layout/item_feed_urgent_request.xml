<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="@color/surface_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================= TOP HEADER: BLOOD BADGE + DETAILS + SHARE BUTTON ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <!-- PROMINENT BLOOD GROUP SQUIRCLE BADGE (CLASSY SOFT ROSE) -->
            <TextView
                android:id="@+id/tvBloodGroupBadge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_blood_badge_classy"
                android:gravity="center"
                android:textColor="@color/crimson_card_blood_text"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="A+" />

            <!-- URGENCY, UNITS, PATIENT & COMPATIBILITY -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <!-- BADGES ROW: URGENT / NEEDED + UNITS -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvUrgencyTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_tag_urgent_2026"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3.5dp"
                        android:text="URGENT"
                        android:textColor="@color/crimson_card_urgent_text"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tvUnitsBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tag_units_2026"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3.5dp"
                        android:textColor="#475569"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        tools:text="2 Units Needed" />
                </LinearLayout>

                <!-- PATIENT NAME -->
                <TextView
                    android:id="@+id/tvPatientName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#0F172A"
                    android:textSize="15.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Patient: Farhana Akhter" />

                <!-- COMPATIBILITY BADGE (DYNAMIC) -->
                <TextView
                    android:id="@+id/tvCompatibilityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_tag_compatibility_2026"
                    android:drawablePadding="5dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Compatible with your blood"
                    android:textColor="#0284C7"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_shield_check_small"
                    app:drawableTint="#0284C7"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <!-- SHARE ICON ON TOP RIGHT -->
            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_share"
                android:background="@drawable/bg_action_btn_classy"
                android:padding="9dp"
                app:tint="#64748B"
                android:contentDescription="Share blood request"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- ================= METADATA CONTAINER: HOSPITAL + LOCATION + TIME ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_meta_container_2026"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- HOSPITAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_hospital"
                    app:tint="#64748B"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvHospital"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:textColor="#1E293B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Dhaka Medical College Hospital" />
            </LinearLayout>

            <!-- LOCATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_location_pin"
                    app:tint="#94A3B8"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Ramna, Dhaka" />
            </LinearLayout>

            <!-- REQUIRED DATE & TIME -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="#94A3B8"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvDateTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Required: 15/01/2026 (04:00 PM)" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= PRIMARY & SECONDARY ACTIONS ROW ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- CALL BUTTON -->
            <ImageView
                android:id="@+id/btnCall"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_call"
                android:background="@drawable/bg_action_btn_classy"
                android:padding="9dp"
                app:tint="@color/card_action_btn_icon"
                android:contentDescription="Call requester"
                tools:ignore="HardcodedText" />

            <!-- CHAT BUTTON -->
            <ImageView
                android:id="@+id/btnChat"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_chat"
                android:background="@drawable/bg_action_btn_classy"
                android:padding="9dp"
                app:tint="@color/card_action_btn_icon"
                android:contentDescription="Chat with requester"
                tools:ignore="HardcodedText" />

            <!-- DIRECTIONS BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDirections"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Directions"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="11dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_directions"
                app:iconSize="14dp"
                app:iconGravity="textStart"
                app:iconTint="#475569"
                android:textAllCaps="false"
                tools:ignore="HardcodedText" />

            <!-- I CAN HELP BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHelp"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.25"
                android:text="I Can Help"
                android:textColor="@color/white"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:cornerRadius="11dp"
                app:backgroundTint="@color/crimson_cta_primary"
                app:elevation="0dp"
                android:textAllCaps="false"
                tools:ignore="HardcodedText" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

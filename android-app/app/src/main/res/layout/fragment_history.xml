<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cardview_light_background">

    <!-- Top Crimson Header with Toolbar matching Request & Chat -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_red_dark">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tvActivityTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activity"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActivitySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Track your blood requests &amp; donations"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Search Bar Matching Chat & Home -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/surface_white"
        app:cardCornerRadius="22dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="#EDEDED">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary"
                tools:ignore="ContentDescription" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Search activity, hospital, blood group..."
                android:paddingStart="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp"
                android:singleLine="true"
                tools:ignore="HardcodedText,RtlSymmetry" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Filter & Sort Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Filter Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilter"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Filter: All"
            android:textAllCaps="false"
            android:textColor="@color/primary_red"
            android:textSize="13sp"
            app:cornerRadius="19dp"
            app:icon="@drawable/ic_filter"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:iconTint="@color/primary_red"
            app:strokeColor="@color/primary_red"
            app:strokeWidth="1dp" />

        <!-- Sort Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSort"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Sort: Recent"
            android:textAllCaps="false"
            android:textColor="@color/primary_red"
            android:textSize="13sp"
            app:cornerRadius="19dp"
            app:icon="@drawable/ic_sort"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:iconTint="@color/primary_red"
            app:strokeColor="@color/primary_red"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Content Area: RecyclerView with SwipeRefresh or Modern Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary_red"
            android:visibility="gone" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="2dp"
                android:paddingBottom="16dp"
                android:visibility="gone"
                tools:listitem="@layout/item_history_request" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Empty State Matching Chat & 2026 UI -->
        <LinearLayout
            android:id="@+id/layoutEmptyHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_activity"
                app:tint="@color/primary_red"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No Activity Yet"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNoHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="When you create a blood request or donate, your activity history will appear here."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyAction"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:text="Request Blood"
                android:textAllCaps="false"
                app:cornerRadius="22dp"
                app:backgroundTint="@color/primary_red"
                android:textColor="@color/white" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:padding="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#D1D5DB"
        android:layout_marginBottom="20dp" />

    <!-- App Logo Icon -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_icon_circle_light"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_blood_drop"
            app:tint="@color/primary_red_dark"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <!-- App Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BloodLink"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save a Life, Donate Blood"
        android:textSize="14sp"
        android:textColor="@color/primary_red_dark"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Version Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_pill"
        android:text="Version 1.0.0 (Build 2026.1)"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BloodLink is a dedicated humanitarian platform engineered to bridge voluntary blood donors and emergency patients across Bangladesh with real-time matching and zero delays.\n\nAll data is handled with strict confidentiality. Blood donation is 100% voluntary, charitable, and non-commercial."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="4dp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseAboutSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Got It"
        android:backgroundTint="@color/primary_red_dark"
        android:textColor="@color/white"
        app:cornerRadius="8dp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_white">

    <!-- Header with Title and Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/primary_red_dark"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Terms of Service"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <ImageView
            android:id="@+id/ivCloseTerms"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            app:tint="@android:color/white"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTermsLastUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last Updated: October 2026"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp" />

            <!-- Section 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Acceptance of Terms"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary_red_dark"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="By accessing and using BloodLink, you acknowledge that you have read, understood, and agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use the application."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="16dp" />

            <!-- Section 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Voluntary &amp; Non-Commercial Pledge"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary_red_dark"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blood donation through BloodLink is strictly voluntary, altruistic, and non-commercial. Buying, selling, or soliciting monetary compensation for blood donation or blood products is strictly illegal and will result in immediate permanent account termination and referral to regulatory authorities."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="16dp" />

            <!-- Section 3 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Donor Eligibility &amp; Accurate Information"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary_red_dark"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Donors represent that all personal information, blood group, contact numbers, and donation eligibility are accurate. Donors must comply with national medical standards regarding minimum age (18+), weight (50kg+), interval between donations (at least 90-120 days), and medical screening."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="16dp" />

            <!-- Section 4 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Emergency Disclaimer"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary_red_dark"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BloodLink acts as a communication facilitator between donors and recipients. While we strive for immediate response, BloodLink is not an emergency hospital service and does not guarantee that a donor will always be available in every location at all times. Always consult hospital staff and emergency services."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="I Understand &amp; Agree"
                android:backgroundTint="@color/primary_red_dark"
                android:textColor="@color/white"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>

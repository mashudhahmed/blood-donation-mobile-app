rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ----------------------------------------------------
    // USERS COLLECTION
    // ----------------------------------------------------
    match /users/{userId} {
      // Any authenticated user can read public user details (name, blood group, etc.)
      allow read: if isAuthenticated();
      // Only the user themselves can create, update, or delete their profile
      allow create, update, delete: if isOwner(userId);
    }

    // ----------------------------------------------------
    // DONORS DIRECTORY
    // ----------------------------------------------------
    match /donors/{donorId} {
      // Authenticated users can browse available donors
      allow read: if isAuthenticated();
      // Only the donor themselves can create, edit, or delete their donor record
      allow create: if isAuthenticated() && (request.auth.uid == donorId || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (request.auth.uid == donorId || resource.data.userId == request.auth.uid);
    }

    // ----------------------------------------------------
    // BLOOD REQUESTS
    // ----------------------------------------------------
    match /bloodRequests/{requestId} {
      // Authenticated users can view pending blood requests
      allow read: if isAuthenticated();
      // Only authenticated users can create requests with their own uid as requesterId
      allow create: if isAuthenticated() && request.resource.data.requesterId == request.auth.uid;
      // The requester can update their request, or other donors can update response/status when helping
      allow update: if isAuthenticated();
      // Only the requester can delete their request
      allow delete: if isAuthenticated() && resource.data.requesterId == request.auth.uid;
    }

    // ----------------------------------------------------
    // CHATS & DIRECT MESSAGES
    // ----------------------------------------------------
    match /chats/{chatId} {
      // Only participants of the conversation can read or create/update conversation metadata
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow delete: if false; // Chats cannot be deleted unilaterally

      // Chat Messages subcollection
      match /messages/{messageId} {
        // Only sender or receiver can read the message
        allow read: if isAuthenticated() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
        // Only the sender can create a new message
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId;
        // Status updates (sent -> delivered -> read) can be written by sender or receiver
        allow update: if isAuthenticated() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
        allow delete: if false;
      }
    }

    // ----------------------------------------------------
    // USER NOTIFICATIONS
    // ----------------------------------------------------
    match /notifications/{userId} {
      allow read, write: if isOwner(userId);

      match /items/{notificationId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    // ----------------------------------------------------
    // PUBLIC DIRECTORIES (Hospitals, Blood Banks)
    // ----------------------------------------------------
    match /hospitals/{hospitalId} {
      allow read: if isAuthenticated();
      allow write: if false; // Read-only for clients, managed via Firebase Console / Admin SDK
    }

    match /bloodBanks/{bankId} {
      allow read: if isAuthenticated();
      allow write: if false; // Read-only for clients, managed via Firebase Console / Admin SDK
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

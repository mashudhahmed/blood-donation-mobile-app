<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:cardMaxElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="#FEE2E2"
    app:cardBackgroundColor="@color/white">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Crisp Vector Background Artwork -->
        <ImageView
            android:id="@+id/ivBannerBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/bg_banner_svg_1"
            android:contentDescription="@null" />

        <!-- Text Content Container (Left-aligned, leaving right side for vector art) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="120dp">

            <!-- Banner Title -->
            <TextView
                android:id="@+id/tvBannerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9F1239"
                android:textSize="19sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                tools:text="Donate Blood Today" />

            <!-- Banner Subtitle -->
            <TextView
                android:id="@+id/tvBannerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#BE123C"
                android:alpha="0.9"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:includeFontPadding="false"
                tools:text="Your blood type could be someone’s hope" />

        </LinearLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>

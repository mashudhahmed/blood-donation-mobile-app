<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#FFCDD2"
    app:cardBackgroundColor="@color/surface_white"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ================= TOP BADGE ROW ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Blood Group Badge -->
            <TextView
                android:id="@+id/tvBloodGroupBadge"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_blood_group_badge"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="O+" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <!-- Urgency Tag -->
                <TextView
                    android:id="@+id/tvUrgencyTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_urgent_tag"
                    android:text="URGENT"
                    android:textColor="@color/primary_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_urgent"
                    app:drawableTint="@color/primary_red"
                    android:drawablePadding="4dp"
                    tools:ignore="HardcodedText" />

                <!-- Units Needed -->
                <TextView
                    android:id="@+id/tvUnitsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_units_pill"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_blood_bag"
                    app:drawableTint="@color/primary_red"
                    android:drawablePadding="4dp"
                    tools:text="2 Units" />
            </LinearLayout>

        </LinearLayout>

        <!-- ================= PATIENT & HOSPITAL ================= -->
        <TextView
            android:id="@+id/tvPatientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Patient: Farhana Akter" />

        <TextView
            android:id="@+id/tvHospital"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            app:drawableStartCompat="@drawable/ic_hospital_small"
            app:drawableTint="@color/text_secondary"
            android:drawablePadding="6dp"
            tools:text="Dhaka Medical College Hospital" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            app:drawableStartCompat="@drawable/ic_location"
            app:drawableTint="@color/text_secondary"
            android:drawablePadding="6dp"
            tools:text="Dhaka Sadar, Dhaka" />

        <TextView
            android:id="@+id/tvDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            app:drawableStartCompat="@drawable/ic_calendar"
            app:drawableTint="@color/text_secondary"
            android:drawablePadding="6dp"
            tools:text="Needed: Today, 3:00 PM" />

        <!-- ================= SEPARATOR ================= -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#F0F0F0" />

        <!-- ================= ACTIONS ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Call Button -->
            <ImageView
                android:id="@+id/btnCall"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_call"
                android:background="@drawable/bg_icon_circle_light"
                android:padding="8dp"
                app:tint="@color/primary_red"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:contentDescription="Call Requester"
                tools:ignore="HardcodedText" />

            <!-- Chat Button -->
            <ImageView
                android:id="@+id/btnChat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_chat"
                android:background="@drawable/bg_icon_circle_light"
                android:padding="8dp"
                app:tint="@color/primary_red"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:contentDescription="Chat with Requester"
                tools:ignore="HardcodedText" />

            <!-- I Can Help Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHelp"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="I Can Help"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/primary_red"
                android:textAllCaps="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EDEDED"
    app:cardBackgroundColor="@color/surface_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ================= TOP HEADER: BLOOD GROUP + TAGS + ACTIONS ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <!-- PROMINENT BLOOD GROUP BADGE -->
            <TextView
                android:id="@+id/tvBloodGroupBadge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_blood_group_badge"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="A+" />

            <!-- URGENCY & UNITS & COMPATIBILITY PILLS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvUrgencyTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_urgent_tag"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:text="URGENT"
                        android:textColor="@color/primary_red"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_clock"
                        app:drawableTint="@color/primary_red"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tvUnitsBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_units_pill"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="2 Units Needed" />
                </LinearLayout>

                <!-- COMPATIBILITY BADGE (DYNAMIC) -->
                <TextView
                    android:id="@+id/tvCompatibilityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_units_pill"
                    android:drawablePadding="4dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Compatible with your blood"
                    android:textColor="#0284C7"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_shield_check_small"
                    app:drawableTint="#0284C7"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <!-- ACTION ICONS: SHARE + CHAT + CALL -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnShare"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_share"
                    android:background="@drawable/bg_icon_circle_light"
                    android:padding="7dp"
                    app:tint="@color/text_secondary"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/btnChat"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_chat"
                    android:background="@drawable/bg_icon_circle_light"
                    android:padding="6dp"
                    app:tint="@color/primary_red"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/btnCall"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_call"
                    android:background="@drawable/bg_icon_circle_light"
                    android:padding="6dp"
                    app:tint="@color/primary_red"
                    tools:ignore="ContentDescription" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= PATIENT NAME ================= -->
        <TextView
            android:id="@+id/tvPatientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Patient: Farhana Akhter" />

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#F3F4F6" />

        <!-- ================= HOSPITAL + LOCATION + TIME DETAILS ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HOSPITAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_hospital"
                    app:tint="@color/text_secondary"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvHospital"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Dhaka Medical College Hospital" />
            </LinearLayout>

            <!-- LOCATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/text_secondary"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Ramna, Dhaka" />
            </LinearLayout>

            <!-- REQUIRED DATE & TIME -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/text_secondary"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvDateTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Required: 15/01/2026 (04:00 PM)" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= ACTION BUTTONS: DIRECTIONS + I CAN HELP ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDirections"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Directions"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:cornerRadius="19dp"
                app:strokeColor="#D1D5DB"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_directions"
                app:iconSize="14dp"
                app:iconGravity="textStart"
                app:iconTint="@color/text_secondary"
                android:textAllCaps="false"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHelp"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="I Can Help"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="19dp"
                app:backgroundTint="@color/primary_red"
                app:icon="@drawable/ic_blood_drop"
                app:iconSize="14dp"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                android:textAllCaps="false"
                tools:ignore="HardcodedText" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

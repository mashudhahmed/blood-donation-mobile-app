<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Screen Content: NavHost + BottomNavigationView -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:defaultNavHost="true"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navGraph="@navigation/nav_graph" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            style="@style/Widget.BloodLink.BottomNavigationView"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_bottom_nav_linkedin"
            android:visibility="gone"
            app:elevation="0dp"
            app:itemActiveIndicatorStyle="@style/Widget.BloodLink.BottomNav.ActiveIndicator"
            app:itemIconSize="22dp"
            app:itemIconTint="@drawable/bottom_nav_icon_color_selector"
            app:itemTextColor="@drawable/bottom_nav_text_color_selector"
            app:itemTextAppearanceActive="@style/TextAppearance.BloodLink.BottomNav.Active"
            app:itemTextAppearanceInactive="@style/TextAppearance.BloodLink.BottomNav.Inactive"
            app:itemRippleColor="@color/bottom_nav_ripple"
            app:itemPaddingTop="11dp"
            app:itemPaddingBottom="7dp"
            app:activeIndicatorLabelPadding="0dp"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Production Grade Material 3 Side Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="false"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_menu"
        app:itemShapeAppearanceOverlay="@style/ShapeAppearance.BloodLink.DrawerItem"
        app:itemShapeFillColor="@color/drawer_item_fill_color"
        app:itemIconTint="@color/drawer_item_icon_tint"
        app:itemTextColor="@color/drawer_item_text_tint"
        app:itemShapeInsetStart="12dp"
        app:itemShapeInsetEnd="12dp"
        app:itemHorizontalPadding="16dp"
        app:itemIconPadding="14dp"
        app:itemVerticalPadding="4dp"
        app:itemTextAppearance="@style/TextAppearance.BloodLink.DrawerItem"
        app:subheaderTextAppearance="@style/TextAppearance.BloodLink.DrawerSubheader"
        app:dividerInsetStart="16dp"
        app:dividerInsetEnd="16dp"
        android:background="@drawable/bg_drawer_m3" />

</androidx.drawerlayout.widget.DrawerLayout>

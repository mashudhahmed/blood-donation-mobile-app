<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.DonateBlood" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your theme here -->
        <item name="colorPrimary">@color/primary_red</item>
        <item name="colorPrimaryVariant">@color/primary_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_red</item>
        <item name="colorSecondaryVariant">@color/primary_red_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/primary_red</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary_red_dark</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background_light</item>

        <!-- Material Pickers default themes -->
        <item name="materialCalendarTheme">@style/ThemeOverlay.BloodLink.MaterialCalendar</item>
        <item name="materialTimePickerTheme">@style/ThemeOverlay.BloodLink.MaterialTimePicker</item>

        <!-- Toolbar/ActionBar theme -->
        <item name="toolbarStyle">@style/Widget.DonateBlood.Toolbar</item>

        <!-- ADD THESE 3 LINES FOR TEXT VISIBILITY -->
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <!-- Toolbar style -->
    <style name="Widget.DonateBlood.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/primary_red</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
    </style>

    <!-- Toolbar Title & Subtitle TextAppearances matching Chat & Message styling -->
    <style name="TextAppearance.BloodLink.Toolbar.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.BloodLink.Toolbar.Subtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#E0E0E0</item>
    </style>

    <!-- Material Date Picker & Time Picker Theme Overlays in BloodLink Theme -->
    <style name="ThemeOverlay.BloodLink.MaterialCalendar" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/primary_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_red</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.BloodLink.MaterialTimePicker" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">@color/primary_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_red</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <!-- Custom Bottom Sheet Dialog Theme with transparent background so rounded card shows -->
    <style name="Theme.BloodLink.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.BloodLink.BottomSheet</item>
    </style>

    <style name="Widget.BloodLink.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Directory TabLayout Text Appearance -->
    <style name="TextAppearance.BloodLink.Tab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
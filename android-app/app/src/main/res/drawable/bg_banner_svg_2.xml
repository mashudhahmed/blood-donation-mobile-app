    <path
        android:fillColor="#33FDA4AF"
        android:pathData="M 305,75 A 24,24 0 1,0 305,123 A 24,24 0 1,0 305,75 Z" />

    <!-- Overlapping Community Circle 3 (cx=305, cy=95, r=24) opacity 0.25 -->
